[node name="HeatmapLabel" type="Label" parent="." unique_id=1210123369]
offset_left = 631.0
offset_top = 410.0
offset_right = 800.0
offset_bottom = 433.0
tooltip_text = "Activation threshold: 0 means the neuron is easiest to activate, while 1 means it is 
hardest. Input neurons are always assigned a threshold of 0, so differences may 
appear even when the activation-threshold genes are identical.

Decay factor: Lower values correspond to slower decay of neuronal 
activity, while higher values correspond to faster decay.

Memory factor: 0 means previous neuronal activity has no persistence, 
while 1 means past activity has the strongest influence on the current state.

Hebbian plasticity rate: 0 means no Hebbian weight adaptation, while higher 
values mean stronger synaptic modification driven by correlated neuronal 
activity.

Polarity factor: -1 represents an inhibitory neuron and +1 represents an 
excitatory neuron.

Connection energy: Values range from -1 to +1 and represent the genetically 
generated spatial connection field. Lower values correspond to regions less 
favored by the connection gene, while higher values correspond to regions 
more strongly favored.

Neuron role: -1 represents an input neuron, 0 represents an internal neuron, and 
+1 represents an output neuron.

Incoming connections: The value is the number of connections received by each 
neuron. The displayed range goes from the minimum to the maximum incoming 
degree found in the entire brain.

For every parameter, the color scale is global across the whole brain. Therefore, 
the same color always represents the same value in every slice."
mouse_filter = 1
theme = SubResource("Theme_dridg")
theme_override_colors/font_color = Color(0.8862745, 0.15686275, 0.15686275, 1)
theme_override_font_sizes/font_size = 16
text = "Parameters Heatmap"

